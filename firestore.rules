rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'ADMIN'; }
    function isGssForFeeder(feederId) {
      return signedIn() && userDoc().data.role == 'GSS' && feederId in userDoc().data.feederIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == 'FARMER');
      allow update: if isAdmin() || (request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.feederIds == resource.data.feederIds);
      allow delete: if isAdmin();
    }

    match /feeders/{feederId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /villages/{villageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (request.resource.data.feederId is string && isGssForFeeder(request.resource.data.feederId));
    }

    match /power_events/{eventId} {
      allow read: if signedIn();
      // Direct client writes are limited to Admin/GSS. Production IoT events
      // must enter through an authenticated server/device ingestion path.
      allow create: if isAdmin()
        || (request.resource.data.feederId is string && isGssForFeeder(request.resource.data.feederId));
      allow update: if isAdmin()
        || (resource.data.feederId is string && isGssForFeeder(resource.data.feederId));
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.feederId is string);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
