rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    function isGssForFeeder(feederId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'GSS'
        && feederId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.feederIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    match /feeders/{feederId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /villages/{villageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (request.resource.data.feederId is string && isGssForFeeder(request.resource.data.feederId));
    }

    match /power_events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin() || (resource.data.feederId is string && isGssForFeeder(resource.data.feederId));
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read, create, update, delete: if signedIn() && (request.auth.uid == request.resource.data.userId || isAdmin());
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
